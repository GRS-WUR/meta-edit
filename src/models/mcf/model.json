{
    "type": "object",
    "x-display": "vertical-stepper",
    "properties": {
        "mcf": {
            "type": "object",
            "x-display": "hidden",
            "properties": {
                "version": {
                    "type": "number",
                    "description": "version of the MCF format",
                    "default": 2.0
                }
            },
            "required": [
                "version"
            ]
        },
        "metadata": {
            "type": "object",
            "title": "Metadata",
            "description": "Information about this metadata record itself",
            "properties": {
                "identifier": {
                    "type": "string",
                    "title": "Identifier",
                    "description": "enter a unique identifier that will be used for the filename; e.g., a project name and data type; students should use a student ID given by the data steward; if multiple records are generated with the same identifier, then a number will be appended to the end"
                },
                "language": {
                    "type": "string",
                    "title": "Language",
                    "description": "primary language used for documenting metadata, as a 2-letter code (e.g., en); the data themselves may be in multiple other languages",
                    "default": "en"
                },
                "language_alternate": {
                    "type": "string",
                    "title": "Alternate language",
                    "description": "optional - 2-letter code of a second language used in this metadata record (e.g., nl)"
                },
                "charset": {
                    "type": "string",
                    "title": "Character set",
                    "description": "character encoding of the metadata record; leave as utf8 unless you know otherwise",
                    "default": "utf8"
                },
                "parentidentifier": {
                    "type": "string",
                    "title": "Parent identifier",
                    "description": "optional - identifier of the record or dataset this record is part of (e.g., a DOI such as DOI:10.4121/20348382.v1); for students, a supervisor identifier (last name)"
                },
                "hierarchylevel": {
                    "type": "string",
                    "title": "Hierarchy level",
                    "description": "level to which the metadata applies (select most appropriate)",
                    "enum": [
                        "dataset",
                        "series",
                        "service",
                        "software",
                        "model",
                        "featureType",
                        "collectionHardware",
                        "collectionSession",
                        "nonGeographicDataset",
                        "propertyType",
                        "fieldSession",
                        "attribute",
                        "attributeType",
                        "tile",
                        "feature",
                        "dimensionGroup"
                    ]
                },
                "dates": {
                    "type": "object",
                    "title": "Metadata dates",
                    "properties": {
                        "creation": {
                            "type": "string",
                            "format": "date",
                            "title": "Creation",
                            "description": "date this metadata record was created"
                        },
                        "revision": {
                            "type": "string",
                            "format": "date",
                            "title": "Revision",
                            "description": "optional - date this metadata record was last revised"
                        }
                    }
                },
                "dataseturi": {
                    "type": "string",
                    "title": "Dataset URI",
                    "description": "optional - persistent URI of the dataset"
                }
            },
            "required": [
                "identifier",
                "hierarchylevel"
            ]
        },
        "spatial": {
            "type": "object",
            "title": "Spatial information",
            "properties": {
                "datatype": {
                    "type": "string",
                    "title": "Data type",
                    "description": "method used to represent geographic information in the dataset",
                    "enum": [
                        "vector",
                        "grid",
                        "textTable",
                        "tin",
                        "stereoModel",
                        "video"
                    ]
                },
                "geomtype": {
                    "type": "string",
                    "title": "Geometry type",
                    "description": "name of point or vector objects used to locate zero-, one-, two-, or three dimensional spatial locations in the dataset",
                    "enum": [
                        "complex",
                        "composite",
                        "curve",
                        "point",
                        "solid",
                        "surface"
                    ]
                }
            }
        },
        "identification": {
            "type": "object",
            "title": "Identification",
            "description": "What the dataset is, when it was made and how it may be used",
            "properties": {
                "language": {
                    "type": "string",
                    "title": "Dataset language",
                    "description": "optional - language(s) used within the dataset, as a 2-letter code"
                },
                "title": {
                    "type": "string",
                    "title": "Title",
                    "description": "name by which the resource is known; e.g., project or thesis title"
                },
                "abstract": {
                    "type": "string",
                    "title": "Abstract",
                    "x-display": "textarea",
                    "description": "brief narrative summary of the content of the resource(s): what was measured, where, when and how"
                },
                "edition": {
                    "type": "string",
                    "title": "Edition",
                    "description": "optional - version of the resource"
                },
                "dates": {
                    "type": "object",
                    "title": "Dataset dates",
                    "description": "fill in at least one",
                    "properties": {
                        "creation": {
                            "type": "string",
                            "format": "date",
                            "title": "Creation",
                            "description": "date the data were collected or created"
                        },
                        "publication": {
                            "type": "string",
                            "format": "date",
                            "title": "Publication",
                            "description": "date the data were published"
                        },
                        "revision": {
                            "type": "string",
                            "format": "date",
                            "title": "Revision",
                            "description": "date the data were last revised"
                        }
                    }
                },
                "keywords": {
                    "type": "array",
                    "title": "Keywords",
                    "description": "a few keywords regarding the main theme(s) of the dataset, project, thesis, etc.; add a group per keyword type or vocabulary",
                    "items": {
                        "type": "object",
                        "properties": {
                            "keywords": {
                                "type": "array",
                                "title": "Keywords",
                                "description": "type a keyword and press Enter",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "keywords_type": {
                                "type": "string",
                                "title": "Keyword type",
                                "enum": [
                                    "theme",
                                    "place",
                                    "discipline",
                                    "stratum",
                                    "temporal"
                                ],
                                "default": "theme"
                            },
                            "vocabulary": {
                                "type": "object",
                                "title": "Vocabulary",
                                "description": "optional - controlled vocabulary the keywords come from",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "title": "Name"
                                    },
                                    "url": {
                                        "type": "string",
                                        "title": "URL"
                                    }
                                }
                            }
                        }
                    }
                },
                "topiccategory": {
                    "type": "array",
                    "title": "Topic categories",
                    "description": "optional - one or more ISO 19115 topic categories",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": [
                            "biota",
                            "boundaries",
                            "climatologyMeteorologyAtmosphere",
                            "economy",
                            "elevation",
                            "environment",
                            "farming",
                            "geoscientificInformation",
                            "health",
                            "imageryBaseMapsEarthCover",
                            "inlandWaters",
                            "intelligenceMilitary",
                            "location",
                            "oceans",
                            "planningCadastre",
                            "society",
                            "structure",
                            "transportation",
                            "utilitiesCommunication"
                        ]
                    }
                },
                "extents": {
                    "type": "object",
                    "title": "Extents",
                    "description": "Coverage of the data in time and space",
                    "properties": {
                        "spatial": {
                            "type": "array",
                            "title": "Spatial extents",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "bbox": {
                                        "type": "array",
                                        "title": "Bounding box",
                                        "description": "geographic extent of the dataset, formatted as a list of [minx,miny,maxx,maxy]; coordinates may be entered one at a time followed by the [Tab] key; default values are for the Netherlands",
                                        "items": {
                                            "type": "number"
                                        },
                                        "minItems": 4,
                                        "maxItems": 6
                                    },
                                    "crs": {
                                        "type": "integer",
                                        "title": "CRS",
                                        "description": "EPSG code of the coordinate reference system (4326 = WGS 84)",
                                        "default": 4326
                                    }
                                }
                            }
                        },
                        "temporal": {
                            "type": "array",
                            "title": "Temporal extents",
                            "description": "optional - period the data cover",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "begin": {
                                        "type": "string",
                                        "format": "date",
                                        "title": "Begin"
                                    },
                                    "end": {
                                        "type": "string",
                                        "format": "date",
                                        "title": "End"
                                    },
                                    "resolution": {
                                        "type": "string",
                                        "title": "Resolution",
                                        "description": "optional - minimum time period resolvable in the dataset, as an ISO 8601 duration, e.g., 'P1D'"
                                    }
                                }
                            }
                        }
                    }
                },
                "accessconstraints": {
                    "type": "string",
                    "title": "Access constraints",
                    "description": "access constraints applied to assure the protection of privacy or intellectual property, and any special restrictions or limitations on obtaining the resource or metadata; if there are none, use 'otherRestrictions'",
                    "enum": [
                        "license",
                        "otherRestrictions",
                        "copyright",
                        "patent",
                        "patentPending",
                        "trademark",
                        "restricted",
                        "intellectualPropertyRights"
                    ]
                },
                "license": {
                    "type": "object",
                    "title": "License",
                    "properties": {
                        "name": {
                            "type": "string",
                            "title": "License name",
                            "description": "name of license applied to the dataset (e.g., CC BY 4.0)"
                        },
                        "url": {
                            "type": "string",
                            "title": "License URL",
                            "description": "link to the license text (e.g., https://creativecommons.org/licenses/by/4.0)"
                        }
                    }
                },
                "rights": {
                    "type": "string",
                    "title": "Rights",
                    "description": "optional - rights statement, e.g., copyright holder and year"
                },
                "url": {
                    "type": "string",
                    "title": "Dataset URL",
                    "description": "optional - landing page of the dataset"
                },
                "status": {
                    "type": "string",
                    "title": "Status",
                    "description": "the status of the resource(s)",
                    "enum": [
                        "completed",
                        "onGoing",
                        "planned",
                        "underDevelopment",
                        "historicalArchive",
                        "required",
                        "obsolete"
                    ]
                },
                "maintenancefrequency": {
                    "type": "string",
                    "title": "Maintenance frequency",
                    "description": "frequency with which modifications and deletions are made to the data after it is first produced",
                    "enum": [
                        "asNeeded",
                        "continual",
                        "daily",
                        "weekly",
                        "fortnightly",
                        "monthly",
                        "quarterly",
                        "biannually",
                        "annually",
                        "irregular",
                        "notPlanned",
                        "unknown"
                    ]
                }
            },
            "required": [
                "title"
            ]
        },
        "content_info": {
            "type": "object",
            "title": "Content information",
            "description": "What the data contain: variables (attributes) and, for imagery, spectral bands (dimensions)",
            "properties": {
                "type": {
                    "type": "string",
                    "title": "Content type",
                    "description": "image for imagery (e.g., UAV or satellite), coverage for other gridded data, feature_catalogue for vector data",
                    "enum": [
                        "image",
                        "coverage",
                        "feature_catalogue"
                    ]
                },
                "processing_level": {
                    "type": "string",
                    "title": "Processing level",
                    "description": "optional - radiometric/geometric processing level of the imagery, e.g., L1"
                },
                "attributes": {
                    "type": "array",
                    "title": "Attributes",
                    "description": "variables contained in the dataset",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "title": "Name",
                                "description": "attribute name as it appears in the data, e.g., a column or band name"
                            },
                            "title": {
                                "type": "string",
                                "title": "Title",
                                "description": "human-readable name"
                            },
                            "type": {
                                "type": "string",
                                "title": "Data type",
                                "enum": [
                                    "string",
                                    "number",
                                    "integer",
                                    "boolean",
                                    "object",
                                    "array"
                                ],
                                "default": "string"
                            },
                            "url": {
                                "type": "string",
                                "title": "URL",
                                "description": "optional - link to a definition of the attribute"
                            },
                            "units": {
                                "type": "string",
                                "title": "Units",
                                "description": "SI units, e.g., mW m-2 sr-1 nm-1"
                            }
                        }
                    }
                },
                "dimensions": {
                    "type": "array",
                    "title": "Dimensions",
                    "description": "for imagery: the sensor's spectral bands",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "title": "Name",
                                "description": "band name, e.g., red or NIR"
                            },
                            "units": {
                                "type": "string",
                                "title": "Units",
                                "description": "e.g., nm"
                            },
                            "min": {
                                "type": "number",
                                "title": "Min",
                                "description": "lower wavelength"
                            },
                            "max": {
                                "type": "number",
                                "title": "Max",
                                "description": "upper wavelength"
                            }
                        }
                    }
                }
            }
        },
        "distribution": {
            "type": "object",
            "title": "Distribution information",
            "description": "Where the data can be accessed",
            "properties": {
                "distributions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "url": {
                                "type": "string",
                                "title": "URL",
                                "description": "location (URL address) for online access"
                            },
                            "type": {
                                "type": "string",
                                "title": "Type",
                                "description": "connection protocol; use WWW:LINK for a web page or repository landing page",
                                "enum": [
                                    "WWW:LINK",
                                    "FILE:GEO",
                                    "FILE:RASTER",
                                    "IETF:GeoJSON",
                                    "OGC:CSW",
                                    "OGC:GPKG",
                                    "OGC:OPS",
                                    "OGC:SOS",
                                    "OGC:WCS",
                                    "OGC:WFS",
                                    "OGC:WMS",
                                    "OGC:WMTS",
                                    "OGC:WPS",
                                    "OGCCov",
                                    "OGCDGGS",
                                    "OGCEDR",
                                    "OGCFeat",
                                    "OGCMaps",
                                    "OGCProc",
                                    "OGCRec",
                                    "OGCRout",
                                    "OGCTile",
                                    "OSGEO:TMS",
                                    "OSM:XYZ"
                                ]
                            },
                            "name": {
                                "type": "string",
                                "title": "Name",
                                "description": "name of the online resource; e.g., Zenodo, 4TU.ResearchData, NAS, etc."
                            },
                            "description": {
                                "type": "string",
                                "title": "Description",
                                "description": "what can be found at this location; saved under the metadata language (e.g., en)"
                            },
                            "function": {
                                "type": "string",
                                "title": "Function",
                                "description": "what the online resource is for",
                                "enum": [
                                    "download",
                                    "information",
                                    "offlineAccess",
                                    "order",
                                    "search"
                                ]
                            }
                        },
                        "required": [
                            "url"
                        ]
                    }
                }
            }
        },
        "contact": {
            "type": "object",
            "title": "Contact information",
            "properties": {
                "contacts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "role": {
                                "type": "string",
                                "title": "Role",
                                "description": "role of this contact; each role can be used once",
                                "enum": [
                                    "owner",
                                    "pointOfContact",
                                    "distributor",
                                    "originator",
                                    "principalInvestigator",
                                    "author",
                                    "publisher",
                                    "custodian",
                                    "processor",
                                    "resourceProvider",
                                    "user"
                                ]
                            },
                            "organization": {
                                "type": "string",
                                "title": "Organization",
                                "description": "name of the responsible organization; GRS unless otherwise specified"
                            },
                            "url": {
                                "type": "string",
                                "title": "URL",
                                "description": "optional - website of the individual or organization"
                            },
                            "individualname": {
                                "type": "string",
                                "title": "Name",
                                "description": "name of the responsible person"
                            },
                            "positionname": {
                                "type": "string",
                                "title": "Position",
                                "description": "position of the responsible person"
                            },
                            "phone": {
                                "type": "string",
                                "title": "Phone"
                            },
                            "fax": {
                                "type": "string",
                                "title": "Fax"
                            },
                            "address": {
                                "type": "string",
                                "title": "Address",
                                "description": "street address"
                            },
                            "city": {
                                "type": "string",
                                "title": "City"
                            },
                            "administrativearea": {
                                "type": "string",
                                "title": "Administrative area",
                                "description": "state or province"
                            },
                            "postalcode": {
                                "type": "string",
                                "title": "Postal code"
                            },
                            "country": {
                                "type": "string",
                                "title": "Country"
                            },
                            "email": {
                                "type": "string",
                                "title": "Email"
                            },
                            "contactinstructions": {
                                "type": "string",
                                "title": "Contact instructions",
                                "description": "optional - how or when to contact the individual or organization"
                            }
                        },
                        "required": [
                            "role",
                            "organization",
                            "email"
                        ]
                    }
                }
            }
        },
        "acquisition": {
            "type": "object",
            "title": "Acquisition",
            "description": "Platforms (e.g., UAV, satellite) and instruments used to collect the data",
            "properties": {
                "platforms": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "identifier": {
                                "type": "string",
                                "title": "Platform",
                                "description": "platform name, e.g., DJI Mavic 2"
                            },
                            "description": {
                                "type": "string",
                                "title": "Description",
                                "description": "e.g., Quadcopter"
                            },
                            "instruments": {
                                "type": "array",
                                "title": "Instruments",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "identifier": {
                                            "type": "string",
                                            "title": "Instrument",
                                            "description": "instrument name, e.g., Parrot Sequoia"
                                        },
                                        "type": {
                                            "type": "string",
                                            "title": "Type",
                                            "description": "e.g., multispectral sensor"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "dataquality": {
            "type": "object",
            "title": "Data quality",
            "properties": {
                "scope": {
                    "type": "object",
                    "title": "Scope",
                    "properties": {
                        "level": {
                            "type": "string",
                            "title": "Level",
                            "description": "level the quality statement applies to, usually dataset",
                            "default": "dataset"
                        }
                    }
                },
                "lineage": {
                    "type": "object",
                    "title": "Lineage",
                    "properties": {
                        "statement": {
                            "type": "string",
                            "title": "Lineage statement",
                            "x-display": "textarea",
                            "description": "how the dataset was produced: sources, processing steps and software"
                        }
                    }
                }
            }
        }
    },
    "required": [
        "mcf",
        "metadata",
        "identification",
        "contact"
    ]
}
